NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
# Set the public origin before deployment so previews and canonical links use it.
VITE_PUBLIC_SITE_URL=
DATABASE_URL=postgresql://postgres:replace-with-your-local-password@localhost:5432/where_to
TEST_DATABASE_URL=postgresql://whereto:replace-with-local-password@localhost:5432/where_to_test?schema=public
TEST_ADMIN_PASSWORD=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Stable database user ID, configured by an operator; never a browser role or email allowlist.
ADMIN_OWNER_USER_ID=
# Continue with Google / Apple: setup steps in docs/social-login.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 key on one line, with \n where the line breaks were.
APPLE_PRIVATE_KEY=
# Real emails (verification, password resets). Free at resend.com; see docs/email.md.
# Until you verify your own domain, keep onboarding@resend.dev: Resend then
# only delivers to the address you signed up to Resend with.
RESEND_API_KEY=
MAIL_FROM=Whereto <onboarding@resend.dev>
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEOAPIFY_API_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=
GETYOURGUIDE_PARTNER_ID=
# Prefer a restricted key (rk_test_...). See docs/stripe.md for the permissions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_TAX_ENABLED=false
EXTERNAL_FREE_ONLY=true
GEOAPIFY_DAILY_CREDITS=2500
GOOGLE_PLACES_MONTHLY_REQUESTS=5000
GOOGLE_ROUTES_MONTHLY_REQUESTS=10000
GROQ_DAILY_TOKENS=180000
STRIPE_MONTHLY_OPERATIONS=10000
EMAIL_MONTHLY_MESSAGES=3000
STORAGE_MONTHLY_WRITE_BYTES=1000000000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=whereto
S3_ACCESS_KEY=
S3_SECRET_KEY=
DATA_DIR=../../.data
# Reverse proxies in front of the API: 1 for nginx (Docker) or Vite (dev).
# Use 2 behind an extra CDN/load balancer. Too high lets clients fake their IP.
TRUST_PROXY=1
# Development only: expose emails (including password-reset links) at
# /api/v1/dev-mail and on the sign-in page. Anyone who can reach the API can
# read them, so leave this off while security testing. When off, links are
# printed in the API terminal instead.
LOCAL_MAILBOX=false
